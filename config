# ============================================
# WR3000K 定制配置种子（main 96M 合并版）
# 目标: MediaTek MT7981 filogic / Tenbay WR3000K
# ============================================
#
# 说明：
# 1. 本文件只写 target 三件套（defconfig 一定认识，不会被丢）。
# 2. 插件在 workflow 里通过 defconfig 后追加 + 校验的方式强制启用，
#    不要写在这里（写了也会被 make defconfig 静默丢弃，这正是上次插件
#    全部缺失的根因）。
#
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_tenbay_wr3000k=y
